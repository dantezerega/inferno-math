# Supabase credentials. Copy to `.env.local` and fill in.
# Find these in your Supabase project: Settings → API.
# Leave blank to run the app in local-only mode (no accounts, localStorage only).

VITE_SUPABASE_URL=
# Use ONE of these (the project's anon key, or the newer publishable key):
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
